# Copy this file to `.env` and fill in your values. Loaded by both the
# training script and the FastAPI server (via python-dotenv).

# Where on disk the trained model lives. The api server reads this.
MODEL_PATH=models/rice_disease_mobilenetv2.h5
LABELS_PATH=models/labels.json

# Hugging Face dataset slug for PlantVillage (rice subset only).
DATASET_SLUG=rice_leaf_diseases
HF_TOKEN=

# Server config
HOST=0.0.0.0
PORT=8000

# Inference server: one folder per crop under MODELS_DIR (see SETUP.md)
MODELS_DIR=ml_backend/models
TOP_K=3
# Defaults when a crop's meta.json doesn't set its own thresholds
CONF_THRESHOLD=0.5
MIN_THRESHOLD=0.4

# Used by training/train_rice.py
IMG_SIZE=224
