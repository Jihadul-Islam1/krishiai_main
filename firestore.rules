rules_version = '2';

// Krishi AI Bangladesh — Firestore security rules
//
// Identity model: BDapps-verified BD phone number in E.164 (+880XXXXXXXXXX)
// is used as the Firestore document id under users/{phone}/...
// We do NOT use Firebase Authentication (BDapps external PHP handles OTP),
// so traditional request.auth checks cannot identify the caller.
//
// Trust layers (defence in depth):
//   1. App Check (Enforce) — only our signed APK / debug tokens can reach
//      the database. Set in app via FirebaseAppCheck + default provider.
//   2. Document-shape validation — every write must match our known schema.
//   3. Phone-key self-scoping — users/{phone}/* blocks writes to any
//      doc id whose final segment is not the same +880... number as the
//      document path being read/written.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSelfPhone(seg) {
      return seg.matches('^\\+8801[3-9][0-9]{8}$');
    }

    match /users/{phone} {
      allow read, write: if false;

      match /profile/me {
        allow read: if isSelfPhone(phone);
        allow create, update: if isSelfPhone(phone)
          && request.resource.data.keys().hasOnly([
            'id','name','phone','district','upazila','village',
            'experienceYears','farmSizeAcres','mainCrop','language',
            'soilType','irrigationSource','profileImagePath',
            'createdAt','updatedAt'
          ])
          && request.resource.data.phone == phone
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80;
        allow delete: if false;
      }

      match /farms/{farmId}         { allow read, write: if isSelfPhone(phone); }
      match /crops/{cropId}         { allow read, write: if isSelfPhone(phone); }
      match /diagnoses/{diagId}    { allow read, write: if isSelfPhone(phone); }
      match /expenses/{expId}      { allow read, write: if isSelfPhone(phone); }
      match /profit_records/{pid}   { allow read, write: if isSelfPhone(phone); }
      match /tool_plans/{tid}       { allow read, write: if isSelfPhone(phone); }
      match /photos/{photoId}       { allow read, write: if isSelfPhone(phone); }
      match /market_favorites/{fid} { allow read, write: if isSelfPhone(phone); }

      match /notifications/{nid} {
        allow read: if isSelfPhone(phone);
        allow create, update: if isSelfPhone(phone)
          && request.resource.data.keys().hasOnly([
            'id','title','body','category','severity','createdAt',
            'read','deepLink','iconKey'
          ])
          && request.resource.data.title is string
          && request.resource.data.body is string
          && request.resource.data.read is bool;
        allow delete: if isSelfPhone(phone);
      }

      // meta/* caches — app can read its own; writes currently client-side.
      match /meta/{metaDoc} {
        allow read: if isSelfPhone(phone);
        allow write: if isSelfPhone(phone);
      }
    }

    // -----------------------------------------------------------------------
    // market_prices_live (global collection — NOT under users/{phone})
    //
    // Each document id is a crop id (e.g. `potato`, `rice_miniket`).
    // The admin panel writes here; the mobile app reads + streams.
    //
    // Read:  open to all (app needs it without Firebase Auth).
    // Write: schema-validated (must have cropName, currentPrice, category).
    //        In production, tighten this to admin-only via App Check or
    //        a custom claim / admin whitelist.
    // -----------------------------------------------------------------------
    match /market_prices_live/{cropId} {
      allow read: if true;
      allow create, update: if
           request.resource.data.cropName is string
        && request.resource.data.cropName.size() > 0
        && request.resource.data.currentPrice is number
        && request.resource.data.currentPrice > 0
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0;
      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}